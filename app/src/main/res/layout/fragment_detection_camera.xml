<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : app/src/main/res/layout/fragment_detection_camera.xml -->
<!-- Détection YOLO en temps réel : flux caméra + cadres dessinés par-dessus -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.DetectionCameraFragment">

    <!-- Flux caméra en temps réel (arrière-plan) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/detectionCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay qui dessine les cadres PAR-DESSUS le flux -->
    <fr.mastersd.sime.cheikhahmadoudiop.fruitdetector.view.BoxOverlayView
        android:id="@+id/detectionCameraOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bandeau bas : nombre d'objets détectés -->
    <TextView
        android:id="@+id/detectionCameraText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="2 objet(s) détecté(s)" />

</androidx.constraintlayout.widget.ConstraintLayout>
