<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : app/src/main/res/layout/fragment_camera.xml -->
<!-- Écran caméra : PreviewView + résultat en temps réel -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.CameraFragment">

    <!--
        PreviewView de CameraX : affiche le flux caméra en temps réel.
        Prend tout l'écran en arrière-plan.
    -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bandeau en bas pour afficher le résultat en temps réel -->
    <LinearLayout
        android:id="@+id/resultBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#CC000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Indicateur de chargement pendant l'analyse -->
        <ProgressBar
            android:id="@+id/cameraLoadingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Nom du fruit détecté -->
        <TextView
            android:id="@+id/cameraFruitNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            tools:text="🍎 Pomme" />

        <!-- Score de confiance -->
        <TextView
            android:id="@+id/cameraConfidenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Confiance : 97%" />

        <!-- Message si aucun fruit détecté -->
        <TextView
            android:id="@+id/cameraNoDetectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_detection_message"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="visible" />

        <!-- Bouton pour voir la fiche complète -->
        <Button
            android:id="@+id/cameraViewDetailsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_details_button"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
