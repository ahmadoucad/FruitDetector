<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : app/src/main/res/layout/view_holder_scan.xml -->
<!-- Item de la RecyclerView : un scan de l'historique (cours chapitre 7) -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Nom du fruit/légume détecté -->
    <TextView
        android:id="@+id/historyFruitNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="🍎 Pomme" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Score de confiance -->
        <TextView
            android:id="@+id/historyConfidenceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="97%" />

        <!-- Date et heure du scan -->
        <TextView
            android:id="@+id/historyDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="19/05/2026 14:30" />

    </LinearLayout>

</LinearLayout>
