<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission caméra (mode temps réel) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permission internet (API Open Food Facts + Firebase) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission lecture galerie (mode image) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Compatibilité Android < 13 pour la galerie -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Fonctionnalité caméra requise -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:name=".app.FruitDetectorApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FruitDetector"
        android:usesCleartextTraffic="false">

        <!-- LoginActivity = NOUVEAU point d'entrée (vérifie si connecté) -->
        <activity
            android:name=".view.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity (inscription) -->
        <activity android:name=".view.RegisterActivity" />

        <!-- MainActivity n'est PLUS le point d'entrée (juste déclarée) -->
        <activity android:name=".view.MainActivity" />

    </application>

</manifest>
